# =============================================================================
#  ПРИМЕР ФАЙЛА С ПЕРЕМЕННЫМИ ОКРУЖЕНИЯ
# =============================================================================
#  Как пользоваться:
#    1. Скопируйте этот файл:        cp .env.example .env.local
#    2. Впишите свои значения.
#    3. Никогда не коммитьте .env.local в git — он уже в .gitignore.
#
#  На сервере (Docker) эти же переменные задаются в docker-compose.yml
#  или в .env рядом с ним на сервере.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE  (Project Settings -> API)
# -----------------------------------------------------------------------------
# URL проекта: https://supabase.com/dashboard -> твой проект -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://api.gamedive.ru

# "anon" / "publishable" ключ. Он публичный и попадает в код страницы —
# это нормально, безопасность обеспечивают политики RLS в базе.
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_FROM_SUPABASE_SETTINGS

# service_role ключ. СЕКРЕТНЫЙ! Обходит все проверки RLS.
# Никогда не отдавайте его в браузер и не публикуйте.
# Используется только: вебхук YooKassa и выдача ссылки на файл.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_FROM_SUPABASE_SETTINGS

# -----------------------------------------------------------------------------
# YOOKASSA  (yookassa.ru -> Настройки -> API ключи)
# -----------------------------------------------------------------------------
# Сначала включите тестовый режим и используйте тестовые ключи,
# пока не убедитесь, что всё работает.
YOOKASSA_SHOP_ID=1480066
YOOKASSA_SECRET_KEY=PASTE_YOOKASSA_SECRET_KEY

# -----------------------------------------------------------------------------
# АДРЕС САЙТА
# -----------------------------------------------------------------------------
# Сюда YooKassa возвращает покупателя после оплаты.
# Локально:  http://localhost:3000
# В проде:    https://ваш-домен.ру   (именно https, без слэша в конце)
NEXT_PUBLIC_BASE_URL=https://gamedive.ru

# -----------------------------------------------------------------------------
# ДОПОЛНИТЕЛЬНО (есть значения по умолчанию, менять обычно не нужно)
# -----------------------------------------------------------------------------

# Бакет Supabase Storage с платными файлами (создаётся скриптом
# supabase/migrations/0001_orders.sql).
SUPABASE_STORAGE_BUCKET=paid-files

# Сколько секунд живёт подписанная ссылка на файл. 60 секунд — достаточно.
SUPABASE_SIGNED_URL_TTL=60

# Проверять IP-адрес в вебхуке YooKassa: 1 — да (прод), 0 — нет (локально,
# когда вебхук приходит не с IP YooKassa и его нельзя проверить).
YOOKASSA_WEBHOOK_IP_CHECK=1

DOCKPLOY_API_KEY=PASTE_DOCKPLOY_API_KEY
DOCKPLOY_URL=https://your-dockploy.example.com