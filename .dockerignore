# Файлы, которые НЕ должны попадать в Docker-образ.
# Чем меньше контекст сборки, тем быстрее docker build.

# Зависимости и артефакты сборки ставятся/собираются внутри образа.
node_modules
.next
out
build

# Секреты! Если .env.local попадёт в образ, ключи окажутся в слое изображения.
.env
.env.*
.env.example

# Git и документация
.git
.gitignore
.github
*.md
!README.md

# Логи и системный мусор
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE
.vscode
.idea

# Локальный TypeScript-кэш
*.tsbuildinfo
next-env.d.ts