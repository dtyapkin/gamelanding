import { createClient } from '@/lib/supabase/server'
import { createPayment } from './actions/payment'
import { logout } from './auth/actions'
import Link from 'next/link'

export default async function Home() {
  const supabase = await createClient()
  const {
    data: { user },
  } = await supabase.auth.getUser()

  if (!user) {
    return (
      <main className="min-h-screen flex items-center justify-center bg-gray-50 px-4">
        <div className="text-center">
          <h1 className="text-4xl font-bold mb-4 text-gray-900">Добро пожаловать!</h1>
          <p className="text-gray-600 mb-8">Войдите, чтобы купить книгу</p>
          <Link
            href="/login"
            className="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition-colors"
          >
            Войти
          </Link>
        </div>
      </main>
    )
  }

  // Server Action, привязанный к кнопке покупки
  async function handlePurchase() {
    'use server'
    await createPayment('ebook-1', 1000)
  }

  return (
    <main className="min-h-screen flex items-center justify-center bg-gray-50 px-4">
      <div className="max-w-md w-full text-center">
        <div className="bg-white rounded-lg shadow-md p-8">
          <h1 className="text-2xl font-bold mb-2 text-gray-900">
            Электронная книга
          </h1>
          <p className="text-gray-600 mb-6">
            Полное руководство по Next.js 16
          </p>
          <p className="text-3xl font-bold text-indigo-600 mb-8">1000 ₽</p>

          <form action={handlePurchase}>
            <button
              type="submit"
              className="w-full bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors text-lg font-medium"
            >
              Купить сейчас
            </button>
          </form>

          <div className="mt-6 pt-6 border-t border-gray-200">
            <p className="text-sm text-gray-500 mb-2">
              Вы вошли как: {user.email}
            </p>
            <form action={logout}>
              <button
                type="submit"
                className="text-sm text-red-600 hover:text-red-500"
              >
                Выйти
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
  )
}